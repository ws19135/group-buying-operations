# 複製成 .env.local 後修改。.env* 不會被提交（見 .gitignore）。
# 這個檔案只放「範例值」，不放任何真實憑證。

# development | test | production
APP_ENV=development

# PostgreSQL 連線字串（本機開發資料庫；請勿指向正式資料庫）
DATABASE_URL=postgres://erp:erp_dev_pw@127.0.0.1:5432/erp_dev
# 自動化測試專用資料庫（tests 會重建 schema，內容會被清空）
TEST_DATABASE_URL=postgres://erp:erp_dev_pw@127.0.0.1:5432/erp_test

# 初始系統管理者（只供 npm run db:seed 使用；留空則不建立）
ADMIN_EMAIL=admin@example.invalid
ADMIN_INITIAL_PASSWORD=
ADMIN_NAME=系統管理者

# Demo 資料登入密碼（只供 npm run db:seed:demo；production 環境會被拒絕）
DEMO_PASSWORD=

# 通知 Adapter：test = 只寫入資料庫、不對任何真人發送（預設且目前唯一實作）
NOTIFY_ADAPTER=test

# 排程 Worker 總開關：off = 不執行任何自動化（預設）
AUTOMATION_ENABLED=off

# 僅「公開示範環境」使用：允許在 production 建立虛構 DEMO 資料（放真實資料的環境絕不可設定）
# ALLOW_DEMO_IN_PRODUCTION=yes

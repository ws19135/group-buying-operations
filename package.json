{
  "name": "group-buying-operations",
  "version": "0.1.0",
  "private": true,
  "description": "團購 ERP — Phase 1 MVP（模組化單體：Next.js + TypeScript + PostgreSQL）",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "worker": "tsx scripts/worker.ts",
    "e2e": "tsx scripts/e2e-smoke.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "next": "^15.5.0",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "playwright": "1.63.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.30.0",
    "vitest": "^3.2.0"
  }
}
